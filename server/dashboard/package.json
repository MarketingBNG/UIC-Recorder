{
  "name": "uic-recorder-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web dashboard SPA. Build-only package: everything is a dependency so installs that omit devDependencies still build it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.106.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
