NODE_ENV=production
PORT=8000
PUBLIC_URL=https://calls.example.com
DATABASE_URL=postgresql://USER:PASSWORD@uic-db:5432/uic
STORAGE_DIR=/data/recordings
MAX_UPLOAD_MB=200
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=
# Google Workspace domain: anyone signing in with it is added as an agent automatically
ALLOWED_DOMAIN=usaindiacfo.com
# Comma-separated; these become admins on first sign-in
ADMIN_EMAILS=
# Generate each with: openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=
WORKER_TOKEN=
# Optional: enables bulk import of already-copied recordings (unset = disabled)
IMPORT_TOKEN=

# Optional: Zoho Cliq channel webhook URL for alerts (empty = alerts off).
CLIQ_WEBHOOK_URL=
DEFAULT_PHONE_REGION=IN

# Android OAuth client ID(s). Not read by the server; kept for reference only.
GOOGLE_ANDROID_CLIENT_ID=""
