API_URL=http://uic-api:8000
WORKER_TOKEN=
# stub | faster_whisper | openai | fireflies
TRANSCRIBE_PROVIDER=stub
TRANSCRIBE_LANGUAGE=
OPENAI_API_KEY=
# Fireflies (TRANSCRIBE_PROVIDER=fireflies); budget/batch settings live on the API (dashboard)
FIREFLIES_API_KEY=
FIREFLIES_MAX_WAIT_S=3600
WHISPER_MODEL=large-v3-turbo
# Jobs transcribed in parallel per worker (API providers: 4-8; GPU Whisper: 2-4)
WORKER_CONCURRENCY=4

# English translation with Claude (translate jobs are only claimed when the key is set)
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-opus-5-5
# Backlog calls go in one Message Batch (50% off) per this many calls, or after this many seconds
TRANSLATE_BATCH_MAX=100
TRANSLATE_BATCH_WAIT_S=900
# AI call summaries (summarize jobs, same key and batch settings; queued only when the API has SUMMARIZE_ENABLED)
SUMMARY_MODEL=claude-sonnet-5-5
SUMMARIZE_ENABLED=true

# Sarvam overflow worker (TRANSCRIBE_PROVIDER=sarvam; needs ffmpeg). Off until an admin enables overflow.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_LANGUAGE=unknown

# Re-encode large transcribed recordings to small AAC (needs ffmpeg on PATH; skipped without it)
COMPRESS_ENABLED=true
